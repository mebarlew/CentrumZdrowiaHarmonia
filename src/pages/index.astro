---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SpecialistsSection from '../components/SpecialistsSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import PricingSection from '../components/PricingSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Icon from '../components/Icon.astro';
---

<Layout 
  title="Centrum Zdrowia Psychicznego i Mowy Harmonia - Inowrocław"
  description="Profesjonalna pomoc psychologiczna i logopedyczna w Inowrocławiu. Doświadczony zespół specjalistów oferuje terapię dla dzieci, młodzieży i dorosłych. Umów wizytę już dziś!"
>
  <!-- Hero Section -->
  <Hero />
  
  <!-- About Us / Mission -->
  <section id="o-nas" class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-8">
          O naszym centrum
        </h2>
        <div class="prose prose-lg mx-auto text-text-light">
          <p class="text-xl leading-relaxed mb-8">
            Centrum Zdrowia Psychicznego i Mowy Harmonia to miejsce, gdzie profesjonalizm 
            spotyka się z empatią i zrozumieniem. Nasz zespół składa się z doświadczonych 
            specjalistów w dziedzinie psychologii i logopedii, którzy z pasją pomagają 
            pacjentom w każdym wieku.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
            <div class="text-center">
              <div class="flex justify-center text-primary mb-4">
                <Icon name="trust" class="w-12 h-12" />
              </div>
              <h3 class="text-lg font-semibold text-text mb-2">Zaufanie</h3>
              <p class="text-text-light">Budujemy relacje oparte na wzajemnym szacunku i zrozumieniu</p>
            </div>
            <div class="text-center">
              <div class="flex justify-center text-primary mb-4">
                <Icon name="target" class="w-12 h-12" />
              </div>
              <h3 class="text-lg font-semibold text-text mb-2">Profesjonalizm</h3>
              <p class="text-text-light">Wykorzystujemy sprawdzone metody terapeutyczne i najnowszą wiedzę</p>
            </div>
            <div class="text-center">
              <div class="flex justify-center text-secondary mb-4">
                <Icon name="heart" class="w-12 h-12" />
              </div>
              <h3 class="text-lg font-semibold text-text mb-2">Bezpieczeństwo</h3>
              <p class="text-text-light">Tworzymy przestrzeń, gdzie każdy czuje się wysłuchany i zrozumiany</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Specialists Section -->
  <SpecialistsSection />
  
  <!-- Services Section -->
  <ServicesSection />
  
  <!-- Pricing Section -->
  <PricingSection />
  
  <!-- Contact Section -->
  <ContactSection />
</Layout>

<script>
  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });
</script>