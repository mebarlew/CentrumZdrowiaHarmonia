---
import Layout from '../../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import Markdoc from '@markdoc/markdoc';

export const prerender = true;

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  const newsItems = await reader.collections.news.all();

  return newsItems.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const reader = createReader(process.cwd(), keystaticConfig);
const newsEntry = await reader.collections.news.read(post.slug);

let content = '';
if (newsEntry) {
  const document = await newsEntry.content();
  const ast = Markdoc.parse(document);
  const transformed = Markdoc.transform(ast);
  content = Markdoc.renderers.html(transformed);
}
---

<Layout
  title={`${post.entry.title} | Centrum Zdrowia Harmonia`}
  description={post.entry.excerpt || 'Aktualności z Centrum Zdrowia Psychicznego i Mowy Harmonia'}
>
  <article class="py-16 bg-bg-light">
    <div class="container mx-auto px-4 max-w-3xl">
      <a
        href="/aktualnosci"
        class="inline-flex items-center text-primary hover:text-primary-dark mb-8 transition-colors"
      >
        &larr; Powrót do aktualności
      </a>

      {post.entry.image && (
        <img
          src={post.entry.image}
          alt={post.entry.title}
          class="w-full h-64 md:h-96 object-cover rounded-lg mb-8"
        />
      )}

      <header class="mb-8">
        {post.entry.publishDate && (
          <time
            datetime={post.entry.publishDate}
            class="text-sm text-text-light"
          >
            {new Date(post.entry.publishDate).toLocaleDateString('pl-PL', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>
        )}
        <h1 class="text-3xl md:text-4xl font-display font-bold text-text mt-2">
          {post.entry.title}
        </h1>
      </header>

      <div class="prose prose-lg max-w-none" set:html={content} />
    </div>
  </article>
</Layout>

<style>
  .prose {
    color: #333;
  }
  .prose h2 {
    font-family: 'Poppins', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #333;
  }
  .prose h3 {
    font-family: 'Poppins', sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: #333;
  }
  .prose p {
    margin-bottom: 1rem;
    line-height: 1.75;
  }
  .prose ul {
    list-style-type: disc;
    margin-left: 1.5rem;
    margin-bottom: 1rem;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
  .prose a {
    color: #4A90B8;
    text-decoration: underline;
  }
  .prose a:hover {
    color: #357098;
  }
</style>
