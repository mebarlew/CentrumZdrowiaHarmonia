---
import Layout from '../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

export const prerender = true;

const reader = createReader(process.cwd(), keystaticConfig);
const newsItems = await reader.collections.news.all();

// Sort by date descending
const sortedNews = newsItems.sort((a, b) => {
  const dateA = a.entry.publishDate ? new Date(a.entry.publishDate) : new Date(0);
  const dateB = b.entry.publishDate ? new Date(b.entry.publishDate) : new Date(0);
  return dateB.getTime() - dateA.getTime();
});
---

<Layout title="Aktualności | Centrum Zdrowia Harmonia" description="Aktualności i nowości z Centrum Zdrowia Psychicznego i Mowy Harmonia w Inowrocławiu.">
  <section class="py-16 bg-bg-light">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-display font-bold text-center text-text mb-12">Aktualności</h1>

      {sortedNews.length === 0 ? (
        <p class="text-center text-text-light">Brak aktualności do wyświetlenia.</p>
      ) : (
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {sortedNews.map((post) => (
            <article class="bg-white rounded-lg shadow-soft overflow-hidden hover:shadow-medium transition-shadow">
              {post.entry.image && (
                <img
                  src={post.entry.image}
                  alt={post.entry.title}
                  class="w-full h-48 object-cover"
                  loading="lazy"
                />
              )}
              <div class="p-6">
                {post.entry.publishDate && (
                  <time
                    datetime={post.entry.publishDate}
                    class="text-sm text-text-light"
                  >
                    {new Date(post.entry.publishDate).toLocaleDateString('pl-PL', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </time>
                )}
                <h2 class="text-xl font-display font-semibold text-text mt-2 mb-3">
                  <a
                    href={`/aktualnosci/${post.slug}`}
                    class="hover:text-primary transition-colors"
                  >
                    {post.entry.title}
                  </a>
                </h2>
                {post.entry.excerpt && (
                  <p class="text-text-light line-clamp-3">{post.entry.excerpt}</p>
                )}
                <a
                  href={`/aktualnosci/${post.slug}`}
                  class="inline-block mt-4 text-primary hover:text-primary-dark font-semibold transition-colors"
                >
                  Czytaj więcej &rarr;
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
