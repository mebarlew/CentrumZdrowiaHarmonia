---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { contactInfo, phoneHref, openingHoursRows } from '../data/contact';
import { specialists } from '../data/specialists';
import FacebookIcon from '../components/FacebookIcon.astro';

const phone = contactInfo.phones[0];
---

<Layout
  title="Kontakt - Centrum Zdrowia Psychicznego i Mowy Harmonia"
  description="Skontaktuj się z Centrum Harmonia w Inowrocławiu. Formularz kontaktowy, telefon, adres, godziny otwarcia i bezpośredni kontakt do specjalistek."
>
  <section class="px-6 md:px-edge-margin pt-40 md:pt-48 pb-section-gap max-w-container-max mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-start mb-24 gap-12">
      <div>
        <span class="font-ui-label text-ui-label uppercase tracking-widest text-outline mb-6 block">Kontakt</span>
        <h1 class="font-display-lg text-headline-lg md:text-display-lg text-on-surface tracking-tighter max-w-2xl">Porozmawiajmy</h1>
      </div>
      <p class="font-body-md text-body-md text-on-surface-variant max-w-md md:mt-6">
        Napisz lub zadzwoń. Odpowiadamy najszybciej jak to możliwe i pomagamy dobrać specjalistkę oraz formę wsparcia.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-gutter items-start">
      <div class="lg:col-span-5 glass-panel rounded-3xl p-8 md:p-12 ambient-shadow">
        <ContactForm />
      </div>

      <div class="lg:col-span-7 flex flex-col gap-6">
        <div class="glass-panel rounded-3xl p-2">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2428.5!2d18.26683910094284!3d52.78544526649062!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNTLCsDQ3JzA3LjYiTiAxOMKwMTYnMDAuNiJF!5e0!3m2!1spl!2spl!4v1"
            width="100%"
            height="400"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Lokalizacja Centrum Zdrowia Harmonia"
            class="w-full h-[400px] rounded-2xl"
          ></iframe>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="glass-panel rounded-3xl p-8">
            <h2 class="font-ui-label text-ui-label uppercase tracking-widest text-primary mb-8">Adres i telefon</h2>
            <ul class="flex flex-col gap-4 font-body-md text-on-surface-variant">
              <li>{contactInfo.name}</li>
              <li>{contactInfo.address.street}</li>
              <li>{contactInfo.address.postalCode} {contactInfo.address.city}</li>
              <li class="mt-4"><a class="btn-primary text-primary inline-flex items-center gap-2" href={phoneHref(phone)}><span class="material-symbols-outlined text-[20px]" aria-hidden="true">call</span>+48 {phone}</a></li>
              {contactInfo.facebook && (
                <li><a class="btn-primary text-primary inline-flex items-center gap-2" href={contactInfo.facebook} target="_blank" rel="noopener noreferrer"><FacebookIcon class="w-5 h-5" />Facebook</a></li>
              )}
            </ul>
          </div>
          <div class="glass-panel rounded-3xl p-8">
            <h2 class="font-ui-label text-ui-label uppercase tracking-widest text-primary mb-8">Godziny otwarcia</h2>
            <ul class="flex flex-col gap-4 font-body-md text-on-surface-variant">
              {openingHoursRows.map(entry => (
                <li class="flex justify-between gap-4 border-b border-outline-variant/20 pb-2">
                  <span>{entry.label}</span>
                  <span class="whitespace-nowrap">{entry.time}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="glass-panel rounded-3xl p-8 md:p-12">
          <h2 class="font-ui-label text-ui-label uppercase tracking-widest text-primary mb-8">Bezpośredni kontakt ze specjalistkami</h2>
          <ul>
            {specialists.map(specialist => (
              <li id={specialist.id} class="grid grid-cols-1 md:grid-cols-12 gap-4 py-6 border-b-[0.5px] border-primary/20 first:pt-0 last:border-b-0 last:pb-0 scroll-mt-32">
                <div class="md:col-span-7">
                  <p class="font-display-lg text-headline-lg-mobile tracking-tighter text-on-surface">{specialist.name}</p>
                  <p class="font-ui-label text-[10px] uppercase tracking-widest text-outline mt-2">{specialist.title}</p>
                </div>
                <div class="md:col-span-5 flex flex-col gap-2 font-body-md text-on-surface-variant md:items-end">
                  <a class="btn-primary text-primary" href={phoneHref(specialist.phone)}>+48 {specialist.phone}</a>
                  <a class="btn-primary text-primary break-all" href={`mailto:${specialist.email}`}>{specialist.email}</a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>
