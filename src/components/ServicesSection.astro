---
import { services, categoryLabels } from '../data/services';
import type { Service } from '../types';

type Category = Service['category'];

const descriptionFor = (category: Category) =>
  services.find(service => service.category === category)?.description ?? '';

// Bento layout: each card has its own footprint, so the layout classes live next to the data.
const cards: {
  category: Category;
  number: string;
  icon: string;
  wrapper: string;
  body: string;
  heading: string;
  description: string;
  link?: string;
}[] = [
  {
    category: 'psychology',
    number: '01',
    icon: 'psychology',
    wrapper: 'md:col-span-8',
    body: 'mt-24 md:mt-48 max-w-xl',
    heading: 'text-headline-lg md:text-[64px] mb-6 leading-none group-hover:ml-4 transition-all duration-500 ease-out',
    description: 'text-body-md mb-8',
  },
  {
    category: 'speech-therapy',
    number: '02',
    icon: 'record_voice_over',
    wrapper: 'md:col-span-4 md:row-span-2 relative overflow-hidden',
    body: 'mt-24 relative z-10',
    heading: 'text-headline-lg mb-6 leading-none',
    description: 'text-body-md mb-12',
  },
  {
    category: 'pedagogy',
    number: '03',
    icon: 'auto_stories',
    wrapper: 'md:col-span-4',
    body: 'mt-12',
    heading: 'text-headline-lg-mobile mb-4',
    description: 'text-body-md text-sm mb-6',
  },
  {
    category: 'sensory-integration',
    number: '04',
    icon: 'interests',
    wrapper: 'md:col-span-4',
    body: 'mt-12',
    heading: 'text-headline-lg-mobile mb-4',
    description: 'text-body-md text-sm mb-6',
  },
  {
    category: 'feeding-therapy',
    number: '05',
    icon: 'restaurant',
    wrapper: 'md:col-span-12',
    body: 'mt-12 md:mt-24 md:grid md:grid-cols-12 md:gap-gutter md:items-end',
    heading: 'text-headline-lg mb-4 leading-none md:mb-0 md:col-span-5',
    description: 'text-body-md mb-6 md:mb-0 md:col-span-5',
    link: 'md:col-span-2 md:justify-self-end',
  },
];
---

<section id="terapie" class="px-6 md:px-edge-margin py-section-gap max-w-container-max mx-auto" data-animate="section">
  <div class="flex flex-col md:flex-row justify-between items-start mb-24 gap-12">
    <h2 class="font-display-lg text-headline-lg md:text-display-lg text-on-surface tracking-tighter max-w-2xl">Nasze<br />Terapie</h2>
    <p class="font-body-md text-body-md text-on-surface-variant max-w-md md:mt-6" data-animate="section-subtitle">
      Pięć obszarów specjalistycznego wsparcia dla dzieci, młodzieży i dorosłych. Łączymy sprawdzone metody terapeutyczne z uważnością na potrzeby każdej osoby, która do nas trafia.
    </p>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-12 auto-rows-[minmax(300px,auto)] gap-4 md:gap-6" data-animate="cards">
    {cards.map(card => (
      <article class={`${card.wrapper} glass-panel rounded-3xl p-8 md:p-12 flex flex-col justify-between group hover:bg-surface-bright/80 transition-colors duration-700`} data-animate="card">
        {card.category === 'speech-therapy' && (
          <div class="absolute inset-0 bg-gradient-to-b from-transparent to-surface-variant/20 opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
        )}
        <div class="flex justify-between items-start relative z-10">
          <span class="font-ui-label text-ui-label px-4 py-2 border-[0.5px] border-primary/20 rounded-full text-primary">{card.number}</span>
          <span class="material-symbols-outlined text-4xl text-primary font-light" aria-hidden="true">{card.icon}</span>
        </div>
        <div class={card.body}>
          <h3 class={`font-display-lg tracking-tighter text-on-surface ${card.heading}`}>{categoryLabels[card.category]}</h3>
          <p class={`font-body-md text-on-surface-variant ${card.description}`}>{descriptionFor(card.category)}</p>
          <a class={`btn-primary font-ui-label text-ui-label text-primary ${card.link ?? ''}`} href={`/kontakt?topic=${encodeURIComponent(categoryLabels[card.category])}`}>Umów konsultację</a>
        </div>
      </article>
    ))}
  </div>
</section>
