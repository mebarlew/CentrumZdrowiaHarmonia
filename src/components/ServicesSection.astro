---
import { services } from '../data/services';
import Icon from './Icon.astro';

const psychologyServices = services.filter(service => service.category === 'psychology');
const speechTherapyServices = services.filter(service => service.category === 'speech-therapy');
const pedagogyServices = services.filter(service => service.category === 'pedagogy');
const sensoryIntegrationServices = services.filter(service => service.category === 'sensory-integration');

const ageGroupLabels = {
  children: 'Dzieci',
  adults: 'Dorośli',
  both: 'Dzieci i Dorośli'
};
---

<section id="uslugi" class="py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
        Nasze usługi
      </h2>
      <p class="text-lg md:text-xl text-text-light leading-relaxed">
        Oferujemy kompleksową pomoc w zakresie zdrowia psychicznego i terapii mowy
      </p>
    </div>

    <!-- Psychology Services -->
    <div class="mb-16">
      <div class="flex items-center gap-4 mb-8">
        <div class="text-primary">
          <Icon name="brain" class="w-10 h-10" />
        </div>
        <h3 class="text-2xl md:text-3xl font-display font-semibold text-text">
          Psychologia
        </h3>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6 mb-8">
        {psychologyServices.map((service) => (
          <div class="bg-white rounded-2xl shadow-soft hover:shadow-large hover:-translate-y-2 transition-all duration-300 p-6 h-full">
            <div class="flex items-start gap-4 mb-4">
              <div class="text-primary flex-shrink-0">
                <Icon name="brain" class="w-8 h-8" />
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-semibold text-text mb-1">{service.title}</h3>
                <span class="text-sm text-primary font-medium bg-primary/10 px-3 py-1 rounded-full">
                  {ageGroupLabels[service.ageGroup]}
                </span>
              </div>
            </div>

            <p class="text-text-light mb-6 leading-relaxed">{service.description}</p>

            <ul class="space-y-3">
              {service.items.map((item) => (
                <li class="flex items-start gap-3">
                  <svg class="w-4 h-4 text-secondary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <polyline points="20,6 9,17 4,12"/>
                  </svg>
                  <span class="text-text text-sm">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Speech Therapy Services -->
    <div class="mb-16">
      <div class="flex items-center gap-4 mb-8">
        <div class="text-secondary">
          <Icon name="speech" class="w-10 h-10" />
        </div>
        <h3 class="text-2xl md:text-3xl font-display font-semibold text-text">
          Logopedia i Neurologopedia
        </h3>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6 mb-8">
        {speechTherapyServices.map((service) => (
          <div class="bg-white rounded-2xl shadow-soft hover:shadow-large hover:-translate-y-2 transition-all duration-300 p-6 h-full">
            <div class="flex items-start gap-4 mb-4">
              <div class="text-secondary flex-shrink-0">
                <Icon name="speech" class="w-8 h-8" />
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-semibold text-text mb-1">{service.title}</h3>
                <span class="text-sm text-primary font-medium bg-primary/10 px-3 py-1 rounded-full">
                  {ageGroupLabels[service.ageGroup]}
                </span>
              </div>
            </div>

            <p class="text-text-light mb-6 leading-relaxed">{service.description}</p>

            <ul class="space-y-3">
              {service.items.map((item) => (
                <li class="flex items-start gap-3">
                  <svg class="w-4 h-4 text-secondary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <polyline points="20,6 9,17 4,12"/>
                  </svg>
                  <span class="text-text text-sm">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Pedagogy & Sensory Integration Services - Side by Side -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
      <!-- Pedagogy Services -->
      <div>
        <div class="flex items-center gap-4 mb-8">
          <div class="text-primary">
            <Icon name="book" class="w-10 h-10" />
          </div>
          <h3 class="text-2xl md:text-3xl font-display font-semibold text-text">
            Pedagogika i Terapia
          </h3>
        </div>

        <div class="space-y-6">
          {pedagogyServices.map((service) => (
            <div class="bg-white rounded-2xl shadow-soft hover:shadow-large hover:-translate-y-2 transition-all duration-300 p-6 h-full">
              <div class="flex items-start gap-4 mb-4">
                <div class="text-primary flex-shrink-0">
                  <Icon name="book" class="w-8 h-8" />
                </div>
                <div class="flex-1">
                  <h3 class="text-xl font-semibold text-text mb-1">{service.title}</h3>
                  <span class="text-sm text-primary font-medium bg-primary/10 px-3 py-1 rounded-full">
                    {ageGroupLabels[service.ageGroup]}
                  </span>
                </div>
              </div>

              <p class="text-text-light mb-6 leading-relaxed">{service.description}</p>

              <ul class="space-y-3">
                {service.items.map((item) => (
                  <li class="flex items-start gap-3">
                    <svg class="w-4 h-4 text-secondary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <polyline points="20,6 9,17 4,12"/>
                    </svg>
                    <span class="text-text text-sm">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- Sensory Integration Services -->
      <div>
        <div class="flex items-center gap-4 mb-8">
          <div class="text-secondary">
            <Icon name="sparkles" class="w-10 h-10" />
          </div>
          <h3 class="text-2xl md:text-3xl font-display font-semibold text-text">
            Integracja Sensoryczna
          </h3>
        </div>

        <div class="space-y-6">
          {sensoryIntegrationServices.map((service) => (
            <div class="bg-white rounded-2xl shadow-soft hover:shadow-large hover:-translate-y-2 transition-all duration-300 p-6 h-full">
              <div class="flex items-start gap-4 mb-4">
                <div class="text-secondary flex-shrink-0">
                  <Icon name="sparkles" class="w-8 h-8" />
                </div>
                <div class="flex-1">
                  <h3 class="text-xl font-semibold text-text mb-1">{service.title}</h3>
                  <span class="text-sm text-primary font-medium bg-primary/10 px-3 py-1 rounded-full">
                    {ageGroupLabels[service.ageGroup]}
                  </span>
                </div>
              </div>

              <p class="text-text-light mb-6 leading-relaxed">{service.description}</p>

              <ul class="space-y-3">
                {service.items.map((item) => (
                  <li class="flex items-start gap-3">
                    <svg class="w-4 h-4 text-secondary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <polyline points="20,6 9,17 4,12"/>
                    </svg>
                    <span class="text-text text-sm">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Call to action -->
    <div class="text-center">
      <p class="text-lg text-text-light mb-6">
        Potrzebujesz więcej informacji o naszych usługach?
      </p>
      <a
        href="#kontakt"
        class="inline-flex items-center justify-center px-8 py-4 bg-primary text-white font-semibold rounded-xl text-lg hover:bg-primary-dark transition-all duration-300 hover:shadow-medium hover:-translate-y-0.5"
      >
        Skontaktuj się z nami
      </a>
    </div>
  </div>
</section>
