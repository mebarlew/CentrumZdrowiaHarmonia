---
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<h3 class="text-xl font-headline font-semibold text-on-surface mb-8">Wyślij wiadomość</h3>

<form id="contact-form" class="space-y-6" action="https://api.web3forms.com/submit" method="POST">
  <input type="hidden" name="access_key" value={web3formsKey} />
  <input type="hidden" name="subject" value="Nowa wiadomość z formularza kontaktowego - Centrum Harmonia" />
  <input type="hidden" name="from_name" value="Centrum Zdrowia Harmonia" />
  <input type="hidden" name="botcheck" class="hidden" style="display: none;" />

  <!-- Name -->
  <div class="group">
    <label class="block text-sm font-label mb-2 text-on-surface-variant" for="name">
      Imię i nazwisko <span class="text-error">*</span>
    </label>
    <input
      class="w-full bg-surface-container-high border-none rounded-md p-4 focus:ring-2 focus:ring-primary focus:bg-surface-container-lowest transition-all placeholder-on-surface-variant/40"
      placeholder="Twoje imię"
      type="text"
      id="name"
      name="name"
      required
    />
  </div>

  <!-- Email -->
  <div class="group">
    <label class="block text-sm font-label mb-2 text-on-surface-variant" for="email">
      Email <span class="text-error">*</span>
    </label>
    <input
      class="w-full bg-surface-container-high border-none rounded-md p-4 focus:ring-2 focus:ring-primary focus:bg-surface-container-lowest transition-all placeholder-on-surface-variant/40"
      placeholder="twoj@email.pl"
      type="email"
      id="email"
      name="email"
      required
    />
  </div>

  <!-- Phone -->
  <div class="group">
    <label class="block text-sm font-label mb-2 text-on-surface-variant" for="phone">
      Telefon
    </label>
    <input
      class="w-full bg-surface-container-high border-none rounded-md p-4 focus:ring-2 focus:ring-primary focus:bg-surface-container-lowest transition-all placeholder-on-surface-variant/40"
      placeholder="+48 000 000 000"
      type="tel"
      id="phone"
      name="phone"
    />
  </div>

  <!-- Subject -->
  <div class="group">
    <label class="block text-sm font-label mb-2 text-on-surface-variant" for="subject">
      Temat <span class="text-error">*</span>
    </label>
    <select
      class="w-full bg-surface-container-high border-none rounded-md p-4 focus:ring-2 focus:ring-primary focus:bg-surface-container-lowest transition-all text-on-surface-variant appearance-auto cursor-pointer"
      id="subject"
      name="subject"
      required
    >
      <option value="">Wybierz temat</option>
      <option value="psychology">Konsultacja psychologiczna</option>
      <option value="speech-therapy">Konsultacja logopedyczna</option>
      <option value="appointment">Umówienie wizyty</option>
      <option value="other">Inne pytanie</option>
    </select>
  </div>

  <!-- Message -->
  <div class="group">
    <label class="block text-sm font-label mb-2 text-on-surface-variant" for="message">
      Wiadomość <span class="text-error">*</span>
    </label>
    <textarea
      class="w-full bg-surface-container-high border-none rounded-md p-4 focus:ring-2 focus:ring-primary focus:bg-surface-container-lowest transition-all placeholder-on-surface-variant/40 resize-none"
      placeholder="W czym możemy pomóc?"
      rows="4"
      id="message"
      name="message"
      required
    ></textarea>
  </div>

  <!-- Privacy consent -->
  <div class="flex items-start gap-3">
    <input
      type="checkbox"
      id="privacy"
      name="privacy"
      required
      class="mt-1 w-4 h-4 text-primary border-outline-variant rounded focus:ring-2 focus:ring-primary/20 accent-primary"
    />
    <label for="privacy" class="text-sm text-on-surface-variant leading-relaxed">
      Wyrażam zgodę na przetwarzanie moich danych osobowych zgodnie z
      <a href="/polityka-prywatnosci" class="text-primary hover:text-secondary underline">
        Polityką Prywatności
      </a> <span class="text-error">*</span>
    </label>
  </div>

  <!-- Submit button -->
  <button
    type="submit"
    class="w-full bg-secondary text-on-secondary py-4 rounded-md font-semibold text-lg hover:scale-[1.02] transition-transform shadow-lg shadow-secondary/20"
  >
    Wyślij wiadomość
  </button>

  <!-- Success message -->
  <div id="form-success" class="hidden bg-primary-fixed border border-primary/20 text-on-primary-fixed px-5 py-4 rounded-xl">
    <p class="font-medium">Dziękujemy za wiadomość!</p>
    <p class="text-sm mt-1">Skontaktujemy się z Tobą najszybciej jak to możliwe.</p>
  </div>

  <!-- Error message -->
  <div id="form-error" class="hidden bg-error-container border border-error/20 text-on-error-container px-5 py-4 rounded-xl">
    <p class="font-medium">Wystąpił błąd</p>
    <p class="text-sm mt-1">Spróbuj ponownie lub skontaktuj się z nami telefonicznie.</p>
  </div>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMessage = document.getElementById('form-success');
  const errorMessage = document.getElementById('form-error');
  const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    successMessage?.classList.add('hidden');
    errorMessage?.classList.add('hidden');

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Wysyłanie...';
    }

    const formData = new FormData(form);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData
      });

      const result = await response.json();

      if (result.success) {
        successMessage?.classList.remove('hidden');
        form.reset();
        successMessage?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        throw new Error(result.message || 'Form submission failed');
      }
    } catch {
      errorMessage?.classList.remove('hidden');
      errorMessage?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = 'Wyślij wiadomość';
      }
    }
  });
</script>
