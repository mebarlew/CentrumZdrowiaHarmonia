---
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<div class="bg-white rounded-3xl shadow-soft p-8 md:p-10">
  <h3 class="text-xl font-display font-semibold text-charcoal mb-8">Wyślij wiadomość</h3>

  <form id="contact-form" class="space-y-5" action="https://api.web3forms.com/submit" method="POST">
    <input type="hidden" name="access_key" value={web3formsKey} />
    <input type="hidden" name="subject" value="Nowa wiadomość z formularza kontaktowego - Centrum Harmonia" />
    <input type="hidden" name="from_name" value="Centrum Zdrowia Harmonia" />
    <input type="hidden" name="botcheck" class="hidden" style="display: none;" />

    <!-- Name -->
    <div>
      <label for="name" class="block text-sm font-medium text-charcoal mb-2 tracking-wide">
        Imię i nazwisko <span class="text-error">*</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        class="w-full px-5 py-4 border border-sand rounded-xl focus:ring-2 focus:ring-sage/20 focus:border-sage outline-none transition-all bg-cream/50"
        placeholder="Jan Kowalski"
      />
    </div>

    <!-- Email -->
    <div>
      <label for="email" class="block text-sm font-medium text-charcoal mb-2 tracking-wide">
        Email <span class="text-error">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="w-full px-5 py-4 border border-sand rounded-xl focus:ring-2 focus:ring-sage/20 focus:border-sage outline-none transition-all bg-cream/50"
        placeholder="jan.kowalski@example.com"
      />
    </div>

    <!-- Phone -->
    <div>
      <label for="phone" class="block text-sm font-medium text-charcoal mb-2 tracking-wide">
        Telefon
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        class="w-full px-5 py-4 border border-sand rounded-xl focus:ring-2 focus:ring-sage/20 focus:border-sage outline-none transition-all bg-cream/50"
        placeholder="123 456 789"
      />
    </div>

    <!-- Subject -->
    <div>
      <label for="subject" class="block text-sm font-medium text-charcoal mb-2 tracking-wide">
        Temat <span class="text-error">*</span>
      </label>
      <select
        id="subject"
        name="subject"
        required
        class="w-full px-5 py-4 border border-sand rounded-xl focus:ring-2 focus:ring-sage/20 focus:border-sage outline-none transition-all bg-cream/50"
      >
        <option value="">Wybierz temat</option>
        <option value="psychology">Konsultacja psychologiczna</option>
        <option value="speech-therapy">Konsultacja logopedyczna</option>
        <option value="appointment">Umówienie wizyty</option>
        <option value="other">Inne pytanie</option>
      </select>
    </div>

    <!-- Message -->
    <div>
      <label for="message" class="block text-sm font-medium text-charcoal mb-2 tracking-wide">
        Wiadomość <span class="text-error">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        required
        rows="5"
        class="w-full px-5 py-4 border border-sand rounded-xl focus:ring-2 focus:ring-sage/20 focus:border-sage outline-none transition-all resize-none bg-cream/50"
        placeholder="Opisz jak możemy Ci pomóc..."
      ></textarea>
    </div>

    <!-- Privacy consent -->
    <div class="flex items-start gap-3">
      <input
        type="checkbox"
        id="privacy"
        name="privacy"
        required
        class="mt-1 w-4 h-4 text-sage border-sand rounded focus:ring-2 focus:ring-sage/20 accent-sage"
      />
      <label for="privacy" class="text-sm text-stone leading-relaxed">
        Wyrażam zgodę na przetwarzanie moich danych osobowych zgodnie z
        <a href="/polityka-prywatnosci" class="text-sage hover:text-sage-dark underline">
          Polityką Prywatności
        </a> <span class="text-error">*</span>
      </label>
    </div>

    <!-- Submit button -->
    <button
      type="submit"
      class="w-full py-4 text-base bg-sage-dark text-white font-semibold rounded-xl shadow-medium hover:bg-charcoal hover:shadow-large transition-all duration-300"
    >
      Wyślij wiadomość
    </button>

    <!-- Success message -->
    <div id="form-success" class="hidden bg-sage/10 border border-sage-muted text-sage-dark px-5 py-4 rounded-xl">
      <p class="font-medium">Dziękujemy za wiadomość!</p>
      <p class="text-sm mt-1">Skontaktujemy się z Tobą najszybciej jak to możliwe.</p>
    </div>

    <!-- Error message -->
    <div id="form-error" class="hidden bg-error-light border border-error/20 text-error px-5 py-4 rounded-xl">
      <p class="font-medium">Wystąpił błąd</p>
      <p class="text-sm mt-1">Spróbuj ponownie lub skontaktuj się z nami telefonicznie.</p>
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMessage = document.getElementById('form-success');
  const errorMessage = document.getElementById('form-error');
  const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    successMessage?.classList.add('hidden');
    errorMessage?.classList.add('hidden');

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Wysyłanie...';
    }

    const formData = new FormData(form);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData
      });

      const result = await response.json();

      if (result.success) {
        successMessage?.classList.remove('hidden');
        form.reset();
        successMessage?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        throw new Error(result.message || 'Form submission failed');
      }
    } catch {
      errorMessage?.classList.remove('hidden');
      errorMessage?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = 'Wyślij wiadomość';
      }
    }
  });
</script>
