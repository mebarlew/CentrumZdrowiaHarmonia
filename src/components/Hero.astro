---
import { categoryLabels } from '../data/services';

const interests = Object.values(categoryLabels);
---

<section data-hero class="relative min-h-screen md:min-h-[1024px] flex flex-col justify-center px-6 md:px-edge-margin pt-32 pb-section-gap overflow-hidden max-w-container-max mx-auto">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter items-end relative z-10">
    <div class="md:col-span-8 flex flex-col gap-8 md:pr-12">
      <h1 class="font-display-xl text-[52px] sm:text-[72px] md:text-[88px] lg:text-[104px] xl:text-[120px] leading-[0.95] tracking-tighter text-on-surface" data-animate="hero-title">
        Twoja droga<br />do <span class="italic text-outline font-light">harmonii</span><br />zaczyna się tutaj
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl md:ml-24" data-animate="subtitle">
        Centrum Zdrowia Psychicznego i Mowy w Inowrocławiu. Specjalistyczne wsparcie psychologiczne, logopedyczne i pedagogiczne dla dzieci, młodzieży i dorosłych.
      </p>
    </div>
    <div class="md:col-span-4 flex flex-col items-start md:items-end w-full mt-12 md:mt-0" data-animate="fade-up">
      <form action="/kontakt" method="get" class="glass-panel p-8 rounded-2xl w-full max-w-sm ambient-shadow group hover:-translate-y-2 transition-transform duration-700 ease-out">
        <div class="flex justify-between items-center mb-12">
          <span class="font-ui-label text-ui-label text-primary">Umów wizytę</span>
          <button type="submit" class="text-primary flex items-center transition-transform duration-500 group-hover:translate-x-2" aria-label="Przejdź do formularza kontaktowego">
            <span class="material-symbols-outlined font-light" aria-hidden="true">arrow_forward</span>
          </button>
        </div>
        <div class="space-y-6">
          <div class="border-b-[0.5px] border-primary/20 pb-2 relative">
            <label for="hero-name" class="font-ui-label text-[10px] text-outline uppercase tracking-widest absolute -top-4 left-0">Imię</label>
            <input id="hero-name" name="name" class="w-full bg-transparent border-none p-0 font-body-md text-primary placeholder-surface-tint focus:ring-0 focus:outline-none" placeholder="Twoje imię" type="text" autocomplete="given-name" />
          </div>
          <div class="border-b-[0.5px] border-primary/20 pb-2 relative mt-8">
            <label for="hero-subject" class="font-ui-label text-[10px] text-outline uppercase tracking-widest absolute -top-4 left-0">Zainteresowanie</label>
            <select id="hero-subject" name="topic" class="w-full bg-transparent border-none p-0 font-body-md text-primary focus:ring-0 focus:outline-none appearance-none cursor-pointer">
              {interests.map(label => <option value={label}>{label}</option>)}
            </select>
          </div>
        </div>
      </form>
    </div>
  </div>
  <a href="#terapie" class="absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50 hover:opacity-100 transition-opacity duration-500">
    <span class="font-ui-label text-[10px] tracking-widest text-primary uppercase">Odkryj</span>
    <div class="w-[1px] h-12 bg-primary/30"></div>
  </a>
</section>
