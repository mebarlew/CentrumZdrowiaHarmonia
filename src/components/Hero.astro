---

---

<!-- Direct from Stitch hero.html -->
<section data-hero class="relative min-h-screen flex items-center overflow-hidden bg-surface pt-20">
  <!-- Aura background shapes -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="aura-shape absolute -top-20 -right-20 w-[600px] h-[600px] bg-primary rounded-full"></div>
    <div class="aura-shape absolute top-1/2 -left-40 w-[500px] h-[500px] bg-primary-container rounded-full"></div>
    <div class="aura-shape absolute bottom-[-10%] right-[10%] w-[400px] h-[400px] bg-secondary-container rounded-full"></div>
    <svg class="absolute top-0 right-0 w-1/2 h-full opacity-10" viewBox="0 0 500 800" xmlns="http://www.w3.org/2000/svg">
      <path d="M414.5,565.5Q341,631,234,651.5Q127,672,89.5,586Q52,500,41,393Q30,286,88,198.5Q146,111,257.5,95.5Q369,80,428.5,190Q488,300,451.25,432.75Q414.5,565.5Z" fill="#536350"/>
    </svg>
    <svg class="absolute -bottom-20 left-0 w-1/3 h-1/2 opacity-10" viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg">
      <path d="M447.5,335.5Q398,421,304,449.5Q210,478,131,418Q52,358,47,258.5Q42,159,127.5,102Q213,45,310.5,73Q408,101,452.5,175.5Q497,250,447.5,335.5Z" fill="#a8b9a3"/>
    </svg>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-8 w-full grid md:grid-cols-12 gap-12 items-center">
    <!-- Left column -->
    <div class="md:col-span-7 flex flex-col items-start gap-8">
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-primary/5 rounded-full text-primary font-medium text-sm" data-animate="eyebrow">
        <span class="w-2 h-2 rounded-full bg-primary animate-ping"></span>
        Centrum Zdrowia Psychicznego i Mowy
      </div>

      <h1 class="font-headline text-5xl md:text-7xl lg:text-8xl text-on-surface leading-[1.1] tracking-tight" data-animate="hero-title">
        Twoja droga do <span class="text-primary italic">harmonii</span> zaczyna się tutaj
      </h1>

      <p class="font-body text-lg md:text-xl text-tertiary max-w-2xl leading-relaxed" data-animate="subtitle">
        Centrum Zdrowia Psychicznego i Mowy w Inowrocławiu. Specjalistyczne wsparcie w obszarach psychologii, logopedii, pedagogiki oraz profesjonalna integracja sensoryczna.
      </p>

      <div class="flex flex-col sm:flex-row gap-6 items-start sm:items-center mt-4" data-animate="ctas">
        <a href="#kontakt" class="group relative px-10 py-5 bg-secondary text-on-secondary rounded-full text-lg font-semibold transition-all hover:shadow-2xl hover:shadow-secondary/20 active:scale-95 duration-200 overflow-hidden">
          <span class="relative z-10">Umów wizytę</span>
          <div class="absolute inset-0 bg-white/10 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
        </a>
        <a class="group flex items-center gap-3 text-on-surface font-semibold hover:text-primary transition-colors" href="#uslugi">
          <span class="w-12 h-12 flex items-center justify-center rounded-full border border-outline-variant group-hover:border-primary group-hover:bg-primary/5 transition-all">
            <span class="material-symbols-outlined text-xl">arrow_downward</span>
          </span>
          <span>Nasze usługi</span>
        </a>
      </div>
    </div>

    <!-- Right column — image card -->
    <div class="md:col-span-5 relative hidden md:block" data-animate="fade-up">
      <div class="relative w-full aspect-square rounded-full flex items-center justify-center p-8">
        <div class="absolute inset-0 bg-primary-container/20 rounded-full blur-3xl opacity-50"></div>
        <div class="relative z-10 w-full h-full rounded-[3rem] overflow-hidden rotate-3 hover:rotate-0 transition-transform duration-700 bg-surface-container shadow-2xl shadow-primary/10">
          <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-primary-container/30"></div>
          <img class="w-full h-full object-cover mix-blend-multiply opacity-80" alt="Wnętrze gabinetu terapeutycznego" src="/images/about.webp" />
          <div class="absolute inset-0 p-12 flex flex-col justify-end text-on-primary-container">
            <div class="bg-surface/90 backdrop-blur-md p-6 rounded-2xl border border-white/20">
              <p class="font-headline text-2xl mb-2 italic">"Spokój umysłu to fundament rozwoju."</p>
              <div class="w-12 h-1 bg-secondary rounded-full"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</section>
