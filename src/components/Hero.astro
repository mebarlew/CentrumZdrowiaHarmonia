---

---

<section data-hero class="relative flex items-center overflow-hidden bg-cream">
  <!-- SVG Lineart — left side -->
  <svg
    class="hero-lineart absolute top-0 left-[-5%] w-[70%] md:w-[40%] h-full pointer-events-none"
    viewBox="0 0 400 800"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path class="hero-line" d="M-20 30 C60 80, 120 20, 160 120 C200 220, 120 280, 180 380" stroke="#C8D5C2" stroke-width="1.5" stroke-linecap="round" fill="none" />
    <path class="hero-line" d="M-10 200 C40 180, 80 230, 60 310 C40 390, 100 420, 80 520" stroke="#E8D5A0" stroke-width="1" stroke-linecap="round" fill="none" />
    <path class="hero-line" d="M160 120 C130 100, 90 110, 70 140 C50 170, 80 190, 110 180" stroke="#5B7553" stroke-width="1.2" stroke-linecap="round" fill="none" />
    <circle class="hero-line" cx="160" cy="120" r="25" stroke="#C9A84C" stroke-width="1" fill="none" />
    <path class="hero-line" d="M-30 500 C30 480, 90 520, 70 600 C50 680, 120 700, 100 780" stroke="#8BA583" stroke-width="1" stroke-linecap="round" fill="none" />
    <circle class="hero-line" cx="70" cy="140" r="5" stroke="#C9A84C" stroke-width="1.5" fill="none" />
    <path class="hero-line" d="M80 520 C120 500, 160 540, 140 600" stroke="#C8D5C2" stroke-width="0.8" stroke-linecap="round" fill="none" />
  </svg>

  <!-- SVG Lineart — right side -->
  <svg
    class="hero-lineart absolute top-0 right-[-5%] w-[80%] md:w-[50%] h-full pointer-events-none"
    viewBox="0 0 500 800"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path class="hero-line" d="M450 0 C400 100, 250 140, 220 280 C190 420, 320 480, 280 620 C260 720, 160 760, 100 800" stroke="#C8D5C2" stroke-width="2" stroke-linecap="round" fill="none" />
    <path class="hero-line" d="M500 150 C420 220, 310 200, 260 320 C210 440, 300 520, 200 660" stroke="#8BA583" stroke-width="1.5" stroke-linecap="round" fill="none" />
    <path class="hero-line" d="M220 280 C170 240, 110 230, 70 260 C30 290, 50 340, 100 360" stroke="#5B7553" stroke-width="1.8" stroke-linecap="round" fill="none" />
    <circle class="hero-line" cx="280" cy="320" r="50" stroke="#C9A84C" stroke-width="1.5" fill="none" />
    <path class="hero-line" d="M440 60 C410 90, 380 130, 400 180" stroke="#C9A84C" stroke-width="1.2" stroke-linecap="round" fill="none" />
    <path class="hero-line" d="M280 320 C320 350, 360 330, 390 370 C420 410, 400 450, 360 470" stroke="#E8D5A0" stroke-width="1.2" stroke-linecap="round" fill="none" />
    <path class="hero-line" d="M70 260 C50 235, 25 245, 20 270 C15 295, 40 300, 60 285" stroke="#8BA583" stroke-width="1" stroke-linecap="round" fill="none" />
    <circle class="hero-line" cx="100" cy="360" r="6" stroke="#C9A84C" stroke-width="1.5" fill="none" />
    <path class="hero-line" d="M480 400 C440 420, 400 380, 360 430 C320 480, 360 530, 320 580" stroke="#C8D5C2" stroke-width="1" stroke-linecap="round" fill="none" />
    <path class="hero-line" d="M200 660 C160 690, 120 670, 90 710 C60 750, 100 780, 80 800" stroke="#E8D5A0" stroke-width="1" stroke-linecap="round" fill="none" />
    <circle class="hero-line" cx="360" cy="470" r="4" stroke="#8BA583" stroke-width="1.5" fill="none" />
    <circle class="hero-line" cx="320" cy="580" r="3" stroke="#C9A84C" stroke-width="1" fill="none" />
    <path class="hero-line" d="M500 600 C460 620, 420 590, 380 640 C340 690, 380 720, 340 760" stroke="#C8D5C2" stroke-width="0.8" stroke-linecap="round" fill="none" />
  </svg>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 pt-32 pb-20 md:pt-40 md:pb-28">
    <div class="max-w-3xl">
      <p class="font-sans font-medium tracking-[0.2em] uppercase text-sage-dark text-sm mb-6" data-animate="eyebrow">
        Centrum Zdrowia Harmonia
      </p>

      <h1 class="text-charcoal mb-8" data-animate="hero-title">
        Profesjonalna pomoc
        <span class="text-sage-dark"> psychologiczna</span> i
        <span class="text-sage-dark"> logopedyczna</span>
      </h1>

      <p class="text-xl md:text-2xl text-charcoal/70 leading-relaxed mb-12 max-w-2xl" data-animate="subtitle">
        Wspólnie tworzymy bezpieczną przestrzeń, gdzie każdy czuje się wysłuchany, zrozumiany i doceniony.
      </p>

      <div class="flex items-center gap-5 mb-16" data-animate="ctas">
        <a
          href="#kontakt"
          class="inline-flex items-center gap-2.5 px-8 py-4 bg-sage-dark text-white font-semibold text-base rounded-xl shadow-medium hover:bg-charcoal hover:shadow-large transition-all duration-300 hover:-translate-y-0.5"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Umów wizytę
        </a>
        <a
          href="#uslugi"
          class="inline-flex items-center gap-2 px-8 py-4 bg-white text-charcoal font-semibold text-base rounded-xl shadow-soft border border-sand hover:border-sage hover:text-sage-dark hover:shadow-medium transition-all duration-300 hover:-translate-y-0.5"
        >
          Zobacz ofertę
        </a>
      </div>

      <div class="flex flex-wrap gap-12 md:gap-16">
        <div data-animate="counter" data-count="2">
          <span class="block font-display text-4xl md:text-5xl font-bold text-sage-dark counter-number">0</span>
          <span class="text-charcoal/60 text-sm mt-1 block">Specjalistów</span>
        </div>
        <div data-animate="counter" data-count="18">
          <span class="block font-display text-4xl md:text-5xl font-bold text-sage-dark counter-number">0</span>
          <span class="text-charcoal/60 text-sm mt-1 block">Lat doświadczenia</span>
        </div>
        <div data-animate="counter" data-count="100">
          <div class="flex items-baseline">
            <span class="block font-display text-4xl md:text-5xl font-bold text-sage-dark counter-number">0</span>
            <span class="font-display text-4xl md:text-5xl font-bold text-sage-dark">%</span>
          </div>
          <span class="text-charcoal/60 text-sm mt-1 block">Zaangażowania</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-line {
    stroke-dasharray: 2000;
    stroke-dashoffset: 2000;
    animation: draw-line 2.5s ease-in-out forwards;
  }

  @keyframes draw-line {
    to { stroke-dashoffset: 0; }
  }

  .hero-line:nth-child(1) { animation-delay: 0s; }
  .hero-line:nth-child(2) { animation-delay: 0.15s; }
  .hero-line:nth-child(3) { animation-delay: 0.3s; }
  .hero-line:nth-child(4) { animation-delay: 0.5s; }
  .hero-line:nth-child(5) { animation-delay: 0.2s; }
  .hero-line:nth-child(6) { animation-delay: 0.6s; }
  .hero-line:nth-child(7) { animation-delay: 0.4s; }
  .hero-line:nth-child(8) { animation-delay: 0.7s; }
  .hero-line:nth-child(9) { animation-delay: 0.35s; }
  .hero-line:nth-child(10) { animation-delay: 0.55s; }
  .hero-line:nth-child(11) { animation-delay: 0.8s; }
  .hero-line:nth-child(12) { animation-delay: 0.9s; }
  .hero-line:nth-child(13) { animation-delay: 0.75s; }

  @media (max-width: 768px) {
    .hero-lineart {
      opacity: 0.7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line {
      animation: none;
      stroke-dasharray: none;
      stroke-dashoffset: 0;
    }
  }
</style>
