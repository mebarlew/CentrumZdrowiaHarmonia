---
import { contactInfo, phoneHref, openingHoursRows } from '../data/contact';
import FacebookIcon from './FacebookIcon.astro';

const year = new Date().getFullYear();
const phone = contactInfo.phones[0];
---

<footer class="w-full pt-24 pb-12 border-t-[0.5px] border-outline-variant/30 bg-surface-container-low">
  <div class="px-6 md:px-edge-margin w-full max-w-container-max mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-gutter mb-24">
      <div class="md:col-span-5 flex flex-col">
        <div class="font-display-lg text-display-lg text-on-surface tracking-tighter leading-none mb-6">
          Harmonia
        </div>
        <p class="font-body-md text-on-surface-variant max-w-sm mb-8">
          Centrum Zdrowia Psychicznego i Mowy w Inowrocławiu. Miejsce, w którym wiedza spotyka się z empatią, a każda droga do harmonii zaczyna się od pierwszego kroku.
        </p>
        <div class="flex gap-6">
          <a
            class="w-10 h-10 rounded-full border border-primary/20 flex items-center justify-center text-primary hover:bg-primary hover:text-on-primary transition-colors duration-300"
            href={contactInfo.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
          >
            <FacebookIcon class="w-5 h-5" />
          </a>
        </div>
      </div>
      <div class="md:col-span-3 flex flex-col">
        <h4 class="font-ui-label text-ui-label uppercase tracking-widest text-primary mb-8"><a href="/kontakt" class="btn-primary">Kontakt</a></h4>
        <ul class="flex flex-col gap-4 font-body-md text-on-surface-variant">
          <li>{contactInfo.address.street}</li>
          <li>{contactInfo.address.postalCode} {contactInfo.address.city}</li>
          <li class="mt-4"><a class="hover:text-primary transition-colors btn-primary inline-block" href={phoneHref(phone)}>{phone}</a></li>
        </ul>
      </div>
      <div class="md:col-span-4 flex flex-col">
        <h4 class="font-ui-label text-ui-label uppercase tracking-widest text-primary mb-8">Godziny Otwarcia</h4>
        <ul class="flex flex-col gap-4 font-body-md text-on-surface-variant">
          {openingHoursRows.map(entry => (
            <li class="flex justify-between border-b border-outline-variant/20 pb-2">
              <span>{entry.label}</span>
              <span>{entry.time}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="flex flex-col md:flex-row justify-between items-center pt-8 border-t border-outline-variant/20 gap-6">
      <p class="font-ui-label text-[10px] text-outline uppercase tracking-widest text-center md:text-left">
        © {year} {contactInfo.name}. Wszelkie prawa zastrzeżone.
      </p>
      <ul class="flex gap-8">
        <li><a class="font-ui-label text-[10px] uppercase tracking-widest text-outline hover:text-primary transition-colors duration-300" href="/polityka-prywatnosci">Polityka Prywatności</a></li>
      </ul>
    </div>
  </div>
</footer>
