---
import { contactInfo } from '../data/contact';

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#fff8f3] border-t border-[#665d52]/10 py-12">
  <div class="flex flex-col md:flex-row justify-between items-center px-8 max-w-7xl mx-auto gap-8">
    <div class="font-headline text-lg text-[#211b11]">Harmonia</div>
    <div class="flex flex-wrap justify-center gap-8 text-sm text-[#665d52]">
      <a class="hover:text-[#211b11] transition-all hover:underline" href="#o-nas">O nas</a>
      <a class="hover:text-[#211b11] transition-all hover:underline" href="#specjalisci">Specjaliści</a>
      <a class="hover:text-[#211b11] transition-all hover:underline" href="#uslugi">Usługi</a>
      <a class="hover:text-[#211b11] transition-all hover:underline" href="#cennik">Cennik</a>
      <a class="hover:text-[#211b11] transition-all hover:underline" href="#kontakt">Kontakt</a>
      <a class="hover:text-[#211b11] transition-all hover:underline" href="/polityka-prywatnosci">Polityka prywatności</a>
    </div>
    <div class="text-sm text-[#665d52] text-center md:text-right">
      &copy; {currentYear} {contactInfo.name}. Wszelkie prawa zastrzeżone.
    </div>
  </div>
</footer>
