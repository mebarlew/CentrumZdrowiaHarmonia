---
const navItems = [
  { href: '#o-nas', label: 'O nas' },
  { href: '#specjalisci', label: 'Specjaliści' },
  { href: '#uslugi', label: 'Usługi' },
  { href: '#cennik', label: 'Cennik' },
  { href: '#kontakt', label: 'Kontakt' }
];
---

<header class="bg-white shadow-soft sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="flex items-center justify-between py-4 gap-4" aria-label="Główna nawigacja">
      <!-- Logo -->
      <a href="/" class="flex-shrink-0 flex items-center gap-3" aria-label="Strona główna - Centrum Zdrowia Harmonia">
        <img src="/images/logo.webp" alt="Logo Centrum Zdrowia Harmonia" class="h-12 md:h-14 w-auto" width="56" height="56" fetchpriority="high" />
        <div class="flex flex-col">
          <span class="font-bold text-primary leading-tight text-sm md:text-base">
            Centrum Zdrowia
          </span>
          <span class="text-text-light leading-tight text-xs md:text-sm">
            Psychicznego i Mowy Harmonia
          </span>
        </div>
      </a>
      
      <!-- Mobile menu button -->
      <button
        class="mobile-menu-toggle lg:hidden flex flex-col gap-1 p-2 rounded"
        aria-label="Przełącz menu"
        aria-expanded="false"
      >
        <span class="w-6 h-0.5 bg-text transition-all duration-300"></span>
        <span class="w-6 h-0.5 bg-text transition-all duration-300"></span>
        <span class="w-6 h-0.5 bg-text transition-all duration-300"></span>
      </button>
      
      <!-- Navigation menu -->
      <ul class="
        mobile-menu hidden lg:flex items-center space-x-8 
        lg:relative lg:top-0 lg:bg-transparent lg:shadow-none lg:p-0
        absolute top-full left-0 right-0 bg-white shadow-large
        flex-col lg:flex-row p-6 space-y-4 lg:space-y-0
      ">
        {navItems.map(item => (
          <li>
            <a 
              href={item.href} 
              class="nav-link relative font-medium text-text hover:text-primary transition-colors duration-300 py-2 px-1 block"
            >
              {item.label}
              <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-primary transform transition-transform duration-300 origin-left scale-x-0 hover:scale-x-100"></span>
            </a>
          </li>
        ))}
      </ul>
      
      <!-- Contact button -->
      <div class="hidden lg:block flex-shrink-0">
        <a
          href="tel:+48789115585"
          class="inline-flex items-center gap-2 bg-primary/10 text-primary px-4 py-2 rounded-lg font-medium text-sm hover:bg-primary hover:text-white transition-colors"
          aria-label="Zadzwoń: 789 115 585"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          789 115 585
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('.mobile-menu-toggle');
  const menu = document.querySelector('.mobile-menu');

  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    const isExpanded = !menu?.classList.contains('hidden');
    toggle?.setAttribute('aria-expanded', isExpanded.toString());

    // Animate hamburger icon
    const spans = toggle.querySelectorAll('span');
    if (menu?.classList.contains('hidden')) {
      spans[0].style.transform = '';
      spans[1].style.opacity = '';
      spans[2].style.transform = '';
    } else {
      spans[0].style.transform = 'rotate(45deg) translateY(8px)';
      spans[1].style.opacity = '0';
      spans[2].style.transform = 'rotate(-45deg) translateY(-8px)';
    }
  });
  
  // Close menu when clicking nav links
  document.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      const spans = toggle?.querySelectorAll('span');
      if (spans) {
        spans[0].style.transform = '';
        spans[1].style.opacity = '';
        spans[2].style.transform = '';
      }
    });
  });
</script>