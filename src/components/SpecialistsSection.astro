---
import { specialists } from '../data/specialists';
---

<section id="eksperci" class="px-6 md:px-edge-margin py-section-gap bg-surface-container-low max-w-full" data-animate="section">
  <div class="max-w-container-max mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-start mb-24 gap-12">
      <h2 class="font-display-lg text-headline-lg md:text-display-lg text-on-surface tracking-tighter max-w-2xl">Nasze<br />Specjalistki</h2>
      <p class="font-body-md text-body-md text-on-surface-variant max-w-md md:mt-6" data-animate="section-subtitle">
        Poznaj nasze specjalistki, których doświadczenie i pasja tworzą bezpieczną przestrzeń do rozwoju i zmiany.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-gutter" data-animate="cards">
      {specialists.map((specialist, index) => (
        <article class={`flex flex-col group ${index % 2 === 1 ? 'md:mt-24' : ''}`} data-animate="card">
          <div class="overflow-hidden rounded-3xl aspect-[3/4] mb-8 relative glass-panel p-2">
            <img
              alt={specialist.name}
              class="w-full h-full object-cover rounded-2xl md:grayscale md:group-hover:grayscale-0 transition-all duration-700 ease-out transform group-hover:scale-105"
              src={specialist.image}
              loading="lazy"
              width="600"
              height="800"
            />
          </div>
          <h3 class="font-display-lg text-headline-lg tracking-tighter text-on-surface mb-2">{specialist.name}</h3>
          <p class="font-ui-label text-ui-label text-primary/60 tracking-widest uppercase mb-4">{specialist.title}</p>
          <p class="font-body-md text-on-surface-variant mb-8">{specialist.description}</p>
          <a class="btn-primary font-ui-label text-ui-label text-primary self-start" href={`/kontakt#${specialist.id}`}>Skontaktuj się bezpośrednio</a>
        </article>
      ))}
    </div>
  </div>
</section>
