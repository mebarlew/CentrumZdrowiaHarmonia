---
import type { Specialist } from '../types';

const specialists: Specialist[] = [
  {
    id: '1',
    name: "Joanna Kurczewska-Szczerba",
    title: "Logopeda, neurologopeda, terapeuta miofunkcjonalny",
    description: "Logopeda i neurologopeda z wykształcenia, także politolog. Ukończyła wiele studiów podyplomowych. Od wielu lat pracuje z dziećmi i młodzieżą. Ma bardzo dobre podejście do dzieci, dba o swobodę i bezpieczeństwo w terapii przy osiąganiu widocznych postępów.",
    phone: "505 636 848",
    email: "logopeda.jkurczewska@gmail.com",
    image: "/images/specialist-1.webp"
  },
  {
    id: '2',
    name: "Paulina Baczyńska",
    title: "Psycholog, psychotraumatolog, pedagog",
    description: "Psycholog o specjalności klinicznej oraz psychotraumatolog, pedagog z 18-letnim doświadczeniem. Towarzyszy młodym ludziom w rozwoju, wspiera w trudnościach. Stawia na relację, zaufanie i poczucie bezpieczeństwa.",
    phone: "510 056 057",
    email: "psycholog.pbaczynska@gmail.com",
    image: "/images/specialist-2.webp"
  }
];

const placeholderImage = `data:image/svg+xml;base64,`;
---

<section id="specjalisci" class="py-16 md:py-24 bg-bg-lighter">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
        Nasz zespół specjalistów
      </h2>
      <p class="text-lg md:text-xl text-text-light leading-relaxed mb-6">
        Poznaj naszych doświadczonych specjalistów, którzy z pasją pomagają każdego dnia
      </p>
      <a
        href="tel:+48789115585"
        class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-lg font-medium hover:bg-primary-dark transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        789 115 585
      </a>
    </div>
    
    <!-- Specialists grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 justify-items-center max-w-5xl mx-auto">
      {specialists.map((specialist) => (
        <div class="bg-white rounded-2xl shadow-soft hover:shadow-large hover:-translate-y-2 transition-all duration-300 w-full overflow-hidden flex flex-col">
          <!-- Image -->
          <div class="aspect-[4/3] bg-gradient-to-br from-primary to-secondary flex items-center justify-center">
            <img
              src={specialist.image || placeholderImage}
              alt={`Zdjęcie ${specialist.name}, ${specialist.title}`}
              class="w-full h-full object-cover"
              loading="lazy"
              width="400"
              height="300"
              decoding="async"
              onerror={`this.src='${placeholderImage}'`}
            />
          </div>

          <!-- Content -->
          <div class="p-6 flex flex-col flex-grow">
            <div class="flex-grow">
              <h3 class="text-xl font-semibold text-text mb-2">{specialist.name}</h3>
              <p class="text-primary font-medium text-sm mb-3">{specialist.title}</p>
              <p class="text-text-light leading-relaxed text-sm">{specialist.description}</p>
            </div>

            <div class="mt-6">
              <a
                href={`mailto:${specialist.email}`}
                class="inline-flex items-center gap-2 bg-secondary/10 text-secondary px-4 py-2 rounded-lg font-medium text-sm hover:bg-secondary hover:text-white transition-colors w-full justify-center"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
                Email
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>