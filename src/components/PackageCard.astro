---
import type { PricePackage } from '../types';

export interface Props {
  package: PricePackage;
  class?: string;
}

const { package: pkg, class: className = '' } = Astro.props;
---

<div class={`bg-gradient-to-br from-primary to-primary-dark text-white rounded-xl p-6 hover:shadow-large hover:-translate-y-1 transition-all ${className}`}>
  <div class="flex justify-between items-start mb-4">
    <div>
      <h4 class="font-bold text-lg mb-1">{pkg.name}</h4>
      <p class="text-white/80 text-sm">{pkg.sessions} sesji • ważne {pkg.validityMonths} mies.</p>
    </div>
    <div class="text-right">
      <div class="text-2xl font-bold">{pkg.price} zł</div>
      {pkg.savings && (
        <div class="text-white/80 text-sm">oszczędzasz {pkg.savings} zł</div>
      )}
    </div>
  </div>
  
  <div class="bg-white/20 rounded-lg p-3">
    <div class="text-white/90 text-sm">
      Cena za sesję: <span class="font-semibold">{Math.round(pkg.price / pkg.sessions)} zł</span>
    </div>
  </div>
</div>