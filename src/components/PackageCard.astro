---
import type { PricePackage } from '../types';

export interface Props {
  package: PricePackage;
  featured?: boolean;
  class?: string;
}

const { package: pkg, featured = false, class: className = '' } = Astro.props;
const discountPct = pkg.savings ? Math.round((pkg.savings / (pkg.price + pkg.savings)) * 100) : 0;
---

{featured ? (
  <div class={`bg-surface-container-lowest p-6 rounded-2xl shadow-[0px_20px_40px_rgba(74,66,56,0.12)] border-2 border-secondary/20 relative ${className}`}>
    <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-secondary text-on-primary text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full">
      Najlepsza wartość
    </div>
    <div class="flex justify-between items-start mt-1">
      <h4 class="font-headline text-lg">{pkg.name}</h4>
      {discountPct > 0 && (
        <div class="bg-secondary text-on-primary px-2 py-0.5 rounded-full text-xs font-bold">-{discountPct}%</div>
      )}
    </div>
    <p class="text-tertiary text-xs mt-1">{pkg.sessions} sesji &bull; {pkg.validityMonths} mies. &bull; <span class="font-semibold text-on-surface">{pkg.price} zł</span></p>
    {pkg.savings && <p class="text-secondary text-xs font-medium mt-1">Oszczędzasz {pkg.savings} zł</p>}
    <a href="#kontakt" class="block w-full py-3 mt-4 rounded-xl bg-secondary text-on-primary font-semibold text-sm shadow-lg shadow-secondary/20 hover:opacity-90 active:scale-95 transition-all text-center">
      Kup teraz
    </a>
  </div>
) : (
  <div class={`bg-surface-container-high p-6 rounded-2xl hover:shadow-xl transition-all group ${className}`}>
    <div class="flex justify-between items-start">
      <h4 class="font-headline text-lg">{pkg.name}</h4>
      {discountPct > 0 && (
        <div class="bg-primary/10 text-primary px-2 py-0.5 rounded-full text-xs font-bold">-{discountPct}%</div>
      )}
    </div>
    <p class="text-tertiary text-xs mt-1">{pkg.sessions} sesji &bull; {pkg.validityMonths} mies. &bull; <span class="font-semibold text-on-surface">{pkg.price} zł</span></p>
    {pkg.savings && <p class="text-primary text-xs font-medium mt-1">Oszczędzasz {pkg.savings} zł</p>}
    <a href="#kontakt" class="block w-full py-3 mt-4 rounded-xl border border-primary/20 text-primary font-semibold text-sm group-hover:bg-primary group-hover:text-on-primary transition-all text-center">
      Wybierz pakiet
    </a>
  </div>
)}
