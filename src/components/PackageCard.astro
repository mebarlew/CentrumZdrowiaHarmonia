---
import type { PricePackage } from '../types';

export interface Props {
  package: PricePackage;
  class?: string;
}

const { package: pkg, class: className = '' } = Astro.props;
---

<div class={`relative bg-white/70 backdrop-blur-sm rounded-2xl p-8 border border-gold-light shadow-soft hover:shadow-glow hover:-translate-y-1 transition-all duration-500 overflow-hidden ${className}`}>
  <!-- Gold accent strip -->
  <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-gold to-gold-light"></div>

  <div class="flex justify-between items-start mb-6">
    <div>
      <h4 class="font-display text-lg font-semibold text-charcoal mb-1">{pkg.name}</h4>
      <p class="text-stone text-sm">{pkg.sessions} sesji &bull; ważne {pkg.validityMonths} mies.</p>
    </div>
    <div class="text-right">
      <div class="font-display text-3xl font-bold text-gold">{pkg.price} zł</div>
      {pkg.savings && (
        <span class="inline-block bg-gold/10 text-gold-dark text-xs font-medium px-2.5 py-1 rounded-full mt-1">
          oszczędzasz {pkg.savings} zł
        </span>
      )}
    </div>
  </div>

  <div class="bg-cream-dark rounded-xl p-4">
    <p class="text-stone text-sm">
      Cena za sesję: <span class="font-semibold text-charcoal">{Math.round(pkg.price / pkg.sessions)} zł</span>
    </p>
  </div>
</div>
