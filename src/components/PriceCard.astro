---
import type { PriceItem } from '../types';

export interface Props {
  item: PriceItem;
  class?: string;
}

const { item, class: className = '' } = Astro.props;
---

<div class={`group flex justify-between items-end pb-4 border-b border-outline-variant/30 hover:border-primary/40 transition-colors ${className}`}>
  <div>
    <h3 class="font-headline text-xl text-on-surface group-hover:text-primary transition-colors">{item.name}</h3>
    {item.duration && <p class="text-sm text-tertiary mt-1">{item.duration}</p>}
    {item.description && <p class="text-sm text-tertiary mt-1">{item.description}</p>}
  </div>
  <span class="font-headline text-2xl text-primary whitespace-nowrap ml-4">{item.price} zł</span>
</div>
