---
import type { PriceItem } from '../types';

export interface Props {
  item: PriceItem;
  class?: string;
}

const { item, class: className = '' } = Astro.props;
---

<div class={`bg-white rounded-xl p-5 border border-sand hover:border-sage-muted hover:shadow-soft transition-all duration-300 ${className}`}>
  <div class="flex justify-between items-start gap-4 mb-1">
    <h4 class="font-semibold text-charcoal text-sm leading-snug">{item.name}</h4>
    <span class="font-display text-xl font-bold text-sage whitespace-nowrap">
      {item.price} zł
    </span>
  </div>

  {item.duration && (
    <p class="text-pebble text-xs mb-1">{item.duration}</p>
  )}

  {item.description && (
    <p class="text-stone text-xs leading-relaxed">{item.description}</p>
  )}
</div>
