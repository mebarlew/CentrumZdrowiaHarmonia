---
import PriceCard from './PriceCard.astro';
import PackageCard from './PackageCard.astro';
import { pricingData } from '../data/pricing';
---

<section id="cennik" class="py-16 md:py-24 bg-bg-lighter">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
        Cennik usług
      </h2>
      <p class="text-lg md:text-xl text-text-light leading-relaxed">
        Przejrzyste ceny dla wszystkich naszych usług i pakietów
      </p>
    </div>
    
    <!-- Pricing categories -->
    <div class="space-y-16">
      {pricingData.map((category) => (
        <div class="space-y-8">
          <!-- Category title -->
          <div class="text-center">
            <h3 class="text-2xl md:text-3xl font-display font-semibold text-text mb-4">
              {category.title}
            </h3>
          </div>
          
          <!-- Individual services -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {category.items.map((item) => (
              <PriceCard item={item} />
            ))}
          </div>
          
          <!-- Packages -->
          {category.packages && category.packages.length > 0 && (
            <div class="space-y-6">
              <h4 class="text-xl font-semibold text-text text-center">
                Pakiety {category.id === 'speech-therapy' ? 'logopedyczne' : 'psychologiczne'} (ważne 3 miesiące)
              </h4>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {category.packages.map((pkg) => (
                  <PackageCard package={pkg} />
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </div>
    
    <!-- Contact CTA -->
    <div class="mt-16 text-center">
      <p class="text-lg text-text-light mb-6">
        Masz pytania o cennik? Skontaktuj się z nami!
      </p>
      <a 
        href="#kontakt" 
        class="inline-flex items-center gap-2 bg-primary text-white px-8 py-3 rounded-xl font-semibold hover:bg-primary-dark transition-colors"
      >
        Skontaktuj się
      </a>
    </div>
  </div>
</section>