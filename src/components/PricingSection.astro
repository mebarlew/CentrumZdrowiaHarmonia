---
import PriceCard from './PriceCard.astro';
import PackageCard from './PackageCard.astro';
import { pricingData, equipmentRental } from '../data/pricing';

const packageLabels: Record<string, string> = {
  'speech-therapy': 'logopedyczne',
  'psychology': 'psychologiczne',
  'pedagogy': 'pedagogiczne',
  'sensory-integration': 'SI'
};
---

<section id="cennik" class="py-16 md:py-24 bg-bg-lighter">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
        Cennik usług
      </h2>
      <p class="text-lg md:text-xl text-text-light leading-relaxed">
        Przejrzyste ceny dla wszystkich naszych usług i pakietów
      </p>
      <p class="text-sm text-text-light mt-2">
        Cennik obowiązuje od 1 grudnia 2025 r.
      </p>
    </div>

    <!-- Pricing categories -->
    <div class="space-y-16">
      {pricingData.map((category) => (
        <div class="space-y-8">
          <!-- Category title -->
          <div class="text-center">
            <h3 class="text-2xl md:text-3xl font-display font-semibold text-text mb-4">
              {category.title}
            </h3>
          </div>

          <!-- Individual services -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {category.items.map((item) => (
              <PriceCard item={item} />
            ))}
          </div>

          <!-- Packages -->
          {category.packages && category.packages.length > 0 && (
            <div class="space-y-6">
              <h4 class="text-xl font-semibold text-text text-center">
                Pakiety {packageLabels[category.id] || ''} (ważne 3 miesiące)
              </h4>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {category.packages.map((pkg) => (
                  <PackageCard package={pkg} />
                ))}
              </div>
            </div>
          )}

          <!-- Equipment rental for speech therapy -->
          {category.id === 'speech-therapy' && (
            <div class="mt-6 py-4 px-6 bg-primary/5 border-l-4 border-primary rounded-r-lg">
              <p class="text-text-light">
                <span class="font-medium text-text">Niektóre terapie wymagają elektrostymulatora</span> — dostępny do wypożyczenia:
                <span class="font-semibold text-text">{equipmentRental.electrostimulator.weekly} zł</span>/tydzień lub
                <span class="font-semibold text-text">{equipmentRental.electrostimulator.monthly} zł</span>/miesiąc
                <span class="text-sm">(+ kaucja zwrotna {equipmentRental.electrostimulator.deposit} zł)</span>
              </p>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Contact CTA -->
    <div class="mt-16 text-center">
      <p class="text-lg text-text-light mb-6">
        Masz pytania o cennik? Skontaktuj się z nami!
      </p>
      <a
        href="#kontakt"
        class="inline-flex items-center gap-2 bg-primary text-white px-8 py-3 rounded-xl font-semibold hover:bg-primary-dark transition-colors"
      >
        Skontaktuj się
      </a>
    </div>
  </div>
</section>
