---
import { pricingData } from '../data/pricing';
import { categoryLabels } from '../data/services';

// Home page shows one headline service per category; the full price list lives on /cennik.
const featured = [
  { category: 'psychology', itemId: 'individual-therapy', popular: false },
  { category: 'speech-therapy', itemId: 'therapy', popular: true },
  { category: 'sensory-integration', itemId: 'si-individual', popular: false },
] as const;

const cards = featured.flatMap(entry => {
  const category = pricingData.find(candidate => candidate.id === entry.category);
  const item = category?.items.find(candidate => candidate.id === entry.itemId);
  if (!category || !item) return [];
  const others = category.items.filter(candidate => candidate.id !== entry.itemId).slice(0, 3);
  return [{ ...entry, label: categoryLabels[entry.category], item, others }];
});
---

<section id="cennik" class="px-6 md:px-edge-margin py-section-gap max-w-container-max mx-auto" data-animate="section">
  <div class="text-center mb-24">
    <h2 class="font-display-lg text-headline-lg md:text-display-lg text-on-surface tracking-tighter mb-6">Przejrzysty<br />Cennik</h2>
    <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl mx-auto" data-animate="section-subtitle">
      Jasne stawki bez ukrytych kosztów. Pakiety sesji pozwalają zaoszczędzić nawet 300 zł, a pełny cennik wszystkich terapii znajdziesz na osobnej stronie.
    </p>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-animate="cards">
    {cards.map(card => (
      <article
        class={`glass-panel p-8 md:p-12 rounded-3xl flex flex-col hover:-translate-y-2 transition-transform duration-500 ${card.popular ? 'relative bg-surface-container-high/30' : ''}`}
        data-animate="card"
      >
        {card.popular && (
          <div class="absolute top-0 right-8 bg-primary text-on-primary font-ui-label text-[10px] px-3 py-1 rounded-b-lg tracking-widest uppercase">Popularne</div>
        )}
        <h3 class="font-display-lg text-headline-lg-mobile tracking-tighter text-on-surface mb-2">{card.label}</h3>
        <p class="font-body-md text-on-surface-variant mb-8 text-sm">{card.item.name}</p>
        <div class="font-display-lg text-headline-lg text-primary mb-8 border-b-[0.5px] border-primary/20 pb-8">
          {card.item.priceFrom ? 'od ' : ''}{card.item.price} zł
          {card.item.duration && <span class="font-body-md text-sm text-outline">/ {card.item.duration}</span>}
        </div>
        <ul class="flex flex-col gap-4 mb-12 flex-grow">
          {card.others.map(other => (
            <li class="flex items-center gap-3 font-body-md text-sm text-on-surface-variant">
              <span class="material-symbols-outlined text-primary text-sm" aria-hidden="true">check</span>
              {other.name}
            </li>
          ))}
        </ul>
        <a
          href={`/kontakt?topic=${encodeURIComponent(card.label)}`}
          class={`block text-center w-full py-4 rounded-xl font-ui-label text-ui-label uppercase tracking-widest transition-colors duration-300 ${
            card.popular
              ? 'bg-primary text-on-primary hover:bg-surface-tint'
              : 'border border-primary text-primary hover:bg-primary hover:text-on-primary'
          }`}
        >
          Rezerwuj
        </a>
      </article>
    ))}
  </div>
  <div class="flex justify-center mt-16">
    <a class="btn-primary font-ui-label text-ui-label uppercase tracking-widest text-primary" href="/cennik">Zobacz pełny cennik</a>
  </div>
</section>
