---
import { contactInfo } from '../data/contact';

const specialists = [
  {
    name: "Joanna Kurczewska-Szczerba",
    title: "Logopeda, neurologopeda",
    phone: "505 636 848",
    email: "logopeda.jkurczewska@gmail.com"
  },
  {
    name: "Paulina Baczyńska", 
    title: "Psycholog, psychotraumatolog",
    phone: "510 056 057",
    email: "psycholog.pbaczynska@gmail.com"
  },
  {
    name: "Marta Połeć",
    title: "Psycholog",
    phone: "519 763 554",
    email: "psycholog.mpolec@gmail.com"
  }
];
---

<section id="kontakt" class="py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
        Skontaktuj się z nami
      </h2>
      <p class="text-lg md:text-xl text-text-light leading-relaxed">
        Jesteśmy tutaj, aby Ci pomóc. Skontaktuj się z nami w dogodny dla Ciebie sposób.
      </p>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
      <!-- Contact Information -->
      <div class="space-y-8">
        <!-- Main contact -->
        <div class="bg-bg-light rounded-2xl p-8">
          <h3 class="text-xl font-semibold text-text mb-6">Informacje kontaktowe</h3>
          
          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <svg class="w-5 h-5 text-primary mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <div>
                <p class="font-medium text-text">{contactInfo.address.street}</p>
                <p class="text-text-light">{contactInfo.address.postalCode} {contactInfo.address.city}</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <svg class="w-5 h-5 text-primary mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <div>
                <p class="text-text">{contactInfo.openingHours.weekdays}</p>
                <p class="text-text">{contactInfo.openingHours.saturday}</p>
                <p class="text-text">{contactInfo.openingHours.sunday}</p>
              </div>
            </div>
            
            <div class="flex items-center gap-4">
              <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              <a 
                href={contactInfo.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary hover:text-primary-dark transition-colors"
              >
                Odwiedź nas na Facebooku
              </a>
            </div>
          </div>
        </div>
        
        <!-- Map placeholder -->
        <div class="bg-bg-light rounded-2xl p-8 h-64 flex items-center justify-center">
          <div class="text-center">
            <svg class="w-12 h-12 text-text-light mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <p class="text-text-light">Mapa lokalizacji</p>
            <p class="text-text-light text-sm">{contactInfo.address.street}, {contactInfo.address.city}</p>
          </div>
        </div>
      </div>
      
      <!-- Specialist contacts -->
      <div class="space-y-6">
        <h3 class="text-xl font-semibold text-text mb-6">Kontakt do specjalistów</h3>
        
        {specialists.map((specialist) => (
          <div class="bg-white border border-gray-200 rounded-xl p-6 hover:shadow-medium transition-shadow">
            <h4 class="font-semibold text-text mb-2">{specialist.name}</h4>
            <p class="text-primary text-sm mb-4">{specialist.title}</p>
            
            <div class="flex flex-col sm:flex-row gap-3">
              <a 
                href={`tel:+48${specialist.phone.replace(/\s/g, '')}`}
                class="inline-flex items-center gap-2 bg-primary/10 text-primary px-4 py-2 rounded-lg font-medium text-sm hover:bg-primary hover:text-white transition-colors"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                {specialist.phone}
              </a>
              
              <a 
                href={`mailto:${specialist.email}`}
                class="inline-flex items-center gap-2 bg-secondary/10 text-secondary px-4 py-2 rounded-lg font-medium text-sm hover:bg-secondary hover:text-white transition-colors"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
                Email
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>