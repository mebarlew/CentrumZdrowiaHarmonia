---
import { contactInfo } from '../data/contact';
import ContactForm from './ContactForm.astro';
---

<section id="kontakt" class="max-w-7xl mx-auto px-8 py-20" data-animate="section">
  <div class="mb-16">
    <h1 class="text-5xl md:text-7xl font-headline text-on-surface mb-4">Kontakt</h1>
    <div class="h-1 w-24 bg-secondary rounded-full"></div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
    <!-- Contact Form (Left) -->
    <div class="lg:col-span-5 bg-surface-container-low p-10 rounded-xl">
      <ContactForm />
    </div>

    <!-- Map & Contact Details (Right) -->
    <div class="lg:col-span-7 flex flex-col gap-12">
      <!-- Map -->
      <div class="relative overflow-hidden rounded-xl h-[400px] bg-surface-container-highest">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2428.5!2d18.26683910094284!3d52.78544526649062!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNTLCsDQ3JzA3LjYiTiAxOMKwMTYnMDAuNiJF!5e0!3m2!1spl!2spl!4v1"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Lokalizacja Centrum Zdrowia Harmonia"
          class="w-full h-full"
        ></iframe>
      </div>

      <!-- Contact Details Grid -->
      <div class="grid md:grid-cols-2 gap-8">
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <span class="material-symbols-outlined text-primary mt-1" style="font-variation-settings: 'FILL' 1;">home</span>
            <div>
              <p class="font-label font-bold text-on-surface">Adres</p>
              <p class="text-on-surface-variant">{contactInfo.address.street},<br />{contactInfo.address.postalCode} {contactInfo.address.city}</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="material-symbols-outlined text-primary mt-1" style="font-variation-settings: 'FILL' 1;">call</span>
            <div>
              <p class="font-label font-bold text-on-surface">Telefon</p>
              {contactInfo.phones.map((phone: string) => (
                <p class="text-on-surface-variant">
                  <a href={`tel:+48${phone.replace(/\s/g, '')}`} class="hover:text-primary transition-colors">
                    +48 {phone}
                  </a>
                </p>
              ))}
            </div>
          </div>
        </div>
        <div class="space-y-6">
          {contactInfo.facebook && (
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined text-primary mt-1" style="font-variation-settings: 'FILL' 1;">public</span>
              <div>
                <p class="font-label font-bold text-on-surface">Facebook</p>
                <a href={contactInfo.facebook} target="_blank" rel="noopener noreferrer" class="text-on-surface-variant hover:text-primary transition-colors">
                  Odwiedź nas na Facebooku
                </a>
              </div>
            </div>
          )}
          <div class="flex items-start gap-4">
            <span class="material-symbols-outlined text-primary mt-1" style="font-variation-settings: 'FILL' 1;">schedule</span>
            <div>
              <p class="font-label font-bold text-on-surface">Godziny</p>
              <p class="text-on-surface-variant">{contactInfo.openingHours.weekdays}</p>
              <p class="text-on-surface-variant">{contactInfo.openingHours.saturday}</p>
              <p class="text-on-surface-variant">{contactInfo.openingHours.sunday}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Bottom Banner -->
<div class="max-w-7xl mx-auto px-8 mb-20">
  <div class="bg-tertiary-container/30 p-12 rounded-xl flex flex-col md:flex-row items-center justify-between gap-8">
    <div class="max-w-lg">
      <h3 class="text-3xl font-headline mb-4">Czekamy na Ciebie w naszej przestrzeni spokoju.</h3>
      <p class="text-on-surface-variant">Każda droga do harmonii zaczyna się od pierwszego kroku. Chętnie odpowiemy na wszystkie Twoje pytania.</p>
    </div>
    <div class="flex gap-4">
      {contactInfo.facebook && (
        <a href={contactInfo.facebook} target="_blank" rel="noopener noreferrer" class="w-12 h-12 rounded-full bg-primary-container flex items-center justify-center text-primary cursor-pointer hover:scale-110 transition-transform">
          <span class="material-symbols-outlined">public</span>
        </a>
      )}
      <a href="#kontakt" class="w-12 h-12 rounded-full bg-primary-container flex items-center justify-center text-primary cursor-pointer hover:scale-110 transition-transform">
        <span class="material-symbols-outlined">forum</span>
      </a>
    </div>
  </div>
</div>
