---
import { contactInfo } from '../data/contact';
import ContactForm from './ContactForm.astro';

const specialists = [
  {
    name: "Joanna Kurczewska-Szczerba",
    title: "Logopeda, neurologopeda",
    phone: "505 636 848",
    email: "logopeda.jkurczewska@gmail.com"
  },
  {
    name: "Paulina Baczyńska",
    title: "Psycholog, psychotraumatolog",
    phone: "510 056 057",
    email: "psycholog.pbaczynska@gmail.com"
  }
];
---

<section id="kontakt" class="py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
        Skontaktuj się z nami
      </h2>
      <p class="text-lg md:text-xl text-text-light leading-relaxed">
        Jesteśmy tutaj, aby Ci pomóc. Skontaktuj się z nami w dogodny dla Ciebie sposób.
      </p>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
      <!-- Contact Form -->
      <div class="order-2 lg:order-1">
        <ContactForm />
      </div>

      <!-- Contact Information -->
      <div class="space-y-8 order-1 lg:order-2">
        <!-- Main contact -->
        <div class="bg-bg-light rounded-2xl p-8">
          <h3 class="text-xl font-semibold text-text mb-6">Informacje kontaktowe</h3>
          
          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <svg class="w-5 h-5 text-primary mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <div>
                <p class="font-medium text-text">{contactInfo.address.street}</p>
                <p class="text-text-light">{contactInfo.address.postalCode} {contactInfo.address.city}</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <svg class="w-5 h-5 text-primary mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <div>
                <p class="text-text">{contactInfo.openingHours.weekdays}</p>
                <p class="text-text">{contactInfo.openingHours.saturday}</p>
                <p class="text-text">{contactInfo.openingHours.sunday}</p>
              </div>
            </div>
            
            <div class="flex items-center gap-4">
              <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              <a 
                href={contactInfo.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary hover:text-primary-dark transition-colors"
              >
                Odwiedź nas na Facebooku
              </a>
            </div>
          </div>
        </div>
        
        <!-- Map -->
        <div class="bg-bg-light rounded-2xl overflow-hidden h-80">
          <div id="map" class="w-full h-full"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
     integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
     crossorigin=""/>

<style>
  /* Fix z-index for Leaflet map container to not overlap sticky header (z-50) */
  #map {
    position: relative;
    z-index: 1;
  }

  /* Override all Leaflet z-index values to stay below header */
  .leaflet-pane {
    z-index: 1 !important;
  }

  .leaflet-tile-pane {
    z-index: 1 !important;
  }

  .leaflet-overlay-pane {
    z-index: 2 !important;
  }

  .leaflet-shadow-pane {
    z-index: 3 !important;
  }

  .leaflet-marker-pane {
    z-index: 4 !important;
  }

  .leaflet-tooltip-pane {
    z-index: 5 !important;
  }

  .leaflet-popup-pane {
    z-index: 6 !important;
  }

  .leaflet-map-pane {
    z-index: 1 !important;
  }

  .leaflet-top,
  .leaflet-bottom {
    z-index: 10 !important;
  }

  /* Ensure the map stays below the header but above other content */
  .leaflet-container {
    z-index: 1 !important;
  }
</style>

<!-- Leaflet JS -->
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
     integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
     crossorigin=""></script>

<script is:inline>
  // Wait for DOM to be ready
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize the map
    const map = L.map('map').setView([52.7989, 18.2610], 15);

    // Add OpenStreetMap tiles
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      maxZoom: 19
    }).addTo(map);

    // Add a marker for the location
    const marker = L.marker([52.7989, 18.2610]).addTo(map);

    // Add popup to marker
    marker.bindPopup('<b>Centrum Zdrowia Psychicznego i Mowy Harmonia</b><br>ul. Morelowa 3<br>88-100 Inowrocław').openPopup();

    // Fix z-index for popup pane to stay below sticky header (z-50)
    setTimeout(function() {
      const popupPane = document.getElementsByClassName('leaflet-popup-pane')[0];
      if (popupPane) {
        popupPane.style.zIndex = '40';
      }
    }, 100);
  });
</script>