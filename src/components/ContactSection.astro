---
import { contactInfo } from '../data/contact';
import ContactForm from './ContactForm.astro';
---

<section id="kontakt" class="relative py-24 md:py-32 bg-cream overflow-hidden" data-animate="section">
  <!-- Section lineart — left -->
  <svg class="absolute top-0 left-0 w-[25%] h-full pointer-events-none" viewBox="0 0 250 500" fill="none" aria-hidden="true">
    <path class="section-line" d="M-20 60 C40 90, 100 40, 140 120 C180 200, 100 240, 160 340" stroke="#C8D5C2" stroke-width="1.5" stroke-linecap="round" fill="none" />
    <path class="section-line" d="M-10 250 C30 230, 70 270, 50 330 C30 390, 80 410, 60 460" stroke="#E8D5A0" stroke-width="1" stroke-linecap="round" fill="none" />
    <circle class="section-line" cx="140" cy="120" r="22" stroke="#C9A84C" stroke-width="1" fill="none" />
    <path class="section-line" d="M160 340 C200 320, 240 360, 220 420 C200 480, 250 500, 230 500" stroke="#8BA583" stroke-width="1" stroke-linecap="round" fill="none" />
    <circle class="section-line" cx="50" cy="330" r="5" stroke="#5B7553" stroke-width="1.5" fill="none" />
    <path class="section-line" d="M140 120 C110 100, 80 110, 70 140 C60 170, 90 180, 120 165" stroke="#8BA583" stroke-width="1" stroke-linecap="round" fill="none" />
  </svg>
  <!-- Section lineart — right -->
  <svg class="absolute top-10 right-0 w-[20%] h-[80%] pointer-events-none" viewBox="0 0 200 450" fill="none" aria-hidden="true">
    <path class="section-line" d="M220 40 C180 70, 140 30, 100 100 C60 170, 130 210, 90 300" stroke="#C8D5C2" stroke-width="1" stroke-linecap="round" fill="none" />
    <path class="section-line" d="M200 200 C160 180, 120 220, 100 280 C80 340, 120 360, 100 420" stroke="#E8D5A0" stroke-width="0.8" stroke-linecap="round" fill="none" />
    <circle class="section-line" cx="100" cy="100" r="18" stroke="#C9A84C" stroke-width="1" fill="none" />
    <circle class="section-line" cx="90" cy="300" r="4" stroke="#8BA583" stroke-width="1" fill="none" />
  </svg>
  <div class="relative z-10 max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <!-- Section header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <p class="font-sans font-medium tracking-[0.15em] uppercase text-sage text-sm mb-4" data-animate="section-subtitle">
        Kontakt
      </p>
      <h2 class="mb-6">
        Skontaktuj się z nami
      </h2>
      <p class="text-lg text-stone leading-relaxed" data-animate="section-subtitle">
        Jesteśmy tutaj, aby Ci pomóc. Skontaktuj się z nami w dogodny dla Ciebie sposób.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16" data-animate="cards">
      <!-- Contact Form -->
      <div class="order-2 lg:order-1" data-animate="card">
        <ContactForm />
      </div>

      <!-- Contact Information -->
      <div class="space-y-8 order-1 lg:order-2" data-animate="card">
        <!-- Info card -->
        <div class="glass rounded-3xl p-8">
          <h3 class="text-xl font-display font-semibold text-charcoal mb-6">Informacje kontaktowe</h3>

          <div class="space-y-5">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-sage/10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-sage" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <p class="font-medium text-charcoal">{contactInfo.address.street}</p>
                <p class="text-stone">{contactInfo.address.postalCode} {contactInfo.address.city}</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-sage/10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-sage" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div class="text-stone">
                <p>{contactInfo.openingHours.weekdays}</p>
                <p>{contactInfo.openingHours.saturday}</p>
                <p>{contactInfo.openingHours.sunday}</p>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div class="w-10 h-10 bg-sage/10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-sage" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </div>
              <a
                href={contactInfo.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sage hover:text-sage-dark transition-colors font-medium"
              >
                Odwiedź nas na Facebooku
              </a>
            </div>
          </div>
        </div>

        <!-- Map -->
        <div class="rounded-2xl overflow-hidden shadow-soft h-80">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2428.5!2d18.26683910094284!3d52.78544526649062!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNTLCsDQ3JzA3LjYiTiAxOMKwMTYnMDAuNiJF!5e0!3m2!1spl!2spl!4v1"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Lokalizacja Centrum Zdrowia Harmonia"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
